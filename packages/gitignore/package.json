{
	"name": "@rackrot/pi-gitignore",
	"version": "0.0.0",
	"description": "Create and update .gitignore from toptal/gitignore.io templates plus custom entries (tool and /gitignore command)",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"license": "MIT",
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
