{
	"name": "@rackrot/pi-core",
	"version": "0.1.1",
	"description": "Core rackrot pi extension and shared utilities for the other @rackrot packages",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"license": "MIT",
	"files": [
		"src",
		"README.md"
	],
	"exports": {
		".": "./src/lib.ts",
		"./json": "./src/json.ts",
		"./config": "./src/config.ts",
		"./config-ui": "./src/config-ui.ts",
		"./thinking-binding": "./src/thinking-binding/binding.ts"
	},
	"scripts": {
		"test": "node --test test/*.test.ts"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"jsonc-parser": "^3.3.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rackrot/pi-tools.git",
		"directory": "packages/core"
	}
}
