{
	"name": "@rackrot/pi-agents",
	"version": "0.1.0",
	"description": "Curated pi-subagents agent definitions with settings-driven model/thinking overrides",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-subagents"
	],
	"license": "MIT",
	"files": [
		"src",
		"agents",
		"defaults.json",
		"README.md"
	],
	"scripts": {
		"test": "node --test test/*.test.ts"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"subagents": {
			"agents": [
				"./agents"
			]
		}
	},
	"dependencies": {
		"@rackrot/pi-core": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@tintinweb/pi-subagents": "*"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rackrot/pi-tools.git",
		"directory": "packages/agents"
	}
}
