{
	"name": "@rackrot/pi-forgejo-mcp",
	"version": "0.2.0",
	"description": "Connects pi to a forgejo-mcp server (https://<host>/mcp) with a curated, repo-focused tool set",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"license": "MIT",
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"test": "node --test test/*.test.ts"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"@rackrot/pi-core": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rackrot/pi-tools.git",
		"directory": "packages/forgejo-mcp"
	}
}
