{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!packages/skills/skills",
			"!packages/skills/evals",
			"!packages/jj/skills",
			"!packages/jj/evals",
			"!packages/agents/evals",
			"!packages/memory/evals",
			"!.pi",
			"!packages/agents/workflows",
			"!**/CHANGELOG.md"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useTemplate": "off",
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noAssignInExpressions": "off",
				"noTemplateCurlyInString": "off"
			}
		}
	}
}
